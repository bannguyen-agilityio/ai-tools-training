# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (SQLite). `connection_limit=1` keeps a single writer, which avoids
# SQLITE_BUSY errors under concurrent requests.
DATABASE_URL="file:./dev.db?connection_limit=1"

# Auth
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="1h"
BCRYPT_ROUNDS=12

# Rate limiting (login endpoint)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# CORS — comma separated list of allowed origins, or * for any
CORS_ORIGIN=*

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
