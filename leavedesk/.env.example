# Copy to .env for local dev. Real values live in platform environment variables; never commit them.
ENVIRONMENT=dev
# App connection. Use the pooled Supabase URL in staging/production.
DATABASE_URL=postgresql+psycopg://leavedesk@localhost:5432/leavedesk
# Optional: SET ROLE on every connection (local/CI with an owner URL). Leave empty when the URL logs in as the app role.
DATABASE_ROLE=
# Migrations run as the owner, not the app role.
MIGRATION_DATABASE_URL=
COMPANY_TZ=Asia/Ho_Chi_Minh
# mock is for dev/tests only; the app refuses to start with mock in production.
EMAIL_BACKEND=mock
# A-25: set false only for plain-HTTP local dev.
COOKIE_SECURE=false
