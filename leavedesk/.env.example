# Copy to .env for local dev (or point ENV_FILE at another file). Real values live in platform
# environment variables; never commit them. Every variable below is required unless marked optional.
ENVIRONMENT=dev
# Async SQLAlchemy URL (psycopg driver). Use the pooled Supabase URL in staging/production.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
# Role the app runs as; migrations grant it privileges (no UPDATE/DELETE on audit_log).
APP_DB_ROLE=
# Optional (default false): SET ROLE to APP_DB_ROLE on each connection, for local/CI with an owner URL.
SET_ROLE_ON_CONNECT=false
# Migrations run as the owner. Optional: falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=
COMPANY_TZ=
# mock is for dev/tests only; the app refuses to start with mock in production.
EMAIL_BACKEND=
# A-25: set false only for plain-HTTP local dev.
COOKIE_SECURE=
# Optional: JSON list of extra allowed origins, e.g. ["https://example.com"]
# ALLOWED_ORIGINS=
